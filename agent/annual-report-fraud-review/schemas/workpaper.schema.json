{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single PDF review workpaper 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rules_sha256": {
          "type": "string",
          "minLength": 1
        },
        "graph_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "rules_sha256",
        "graph_sha256"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "company": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "accounting_basis": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "filename",
        "sha256",
        "page_count",
        "company",
        "year",
        "scope",
        "currency",
        "accounting_basis"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "not_reviewed",
              "reviewed",
              "unreadable"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "page",
          "status",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "status": {
            "enum": [
              "not_reviewed",
              "reviewed",
              "unreadable"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "pages",
          "status",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "table_header": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "row": {
            "type": [
              "string",
              "null"
            ]
          },
          "column": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "enum": [
              "unverified",
              "text_checked",
              "page_checked"
            ]
          }
        },
        "required": [
          "id",
          "page",
          "locator",
          "quote",
          "table_header",
          "row",
          "column",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "context": {
            "$ref": "#/$defs/context"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "concept",
          "value",
          "context",
          "evidence_ids",
          "verified"
        ],
        "additionalProperties": false
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "sum",
              "difference",
              "ratio",
              "growth",
              "average_balance",
              "product"
            ]
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                }
              },
              "required": [
                "ref",
                "weight"
              ],
              "additionalProperties": false
            }
          },
          "context": {
            "$ref": "#/$defs/context"
          },
          "period_rule": {
            "enum": [
              "same",
              "comparison",
              "rollforward",
              "balance_flow",
              "sensitivity"
            ]
          },
          "multiplier": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "denominator": {
            "enum": [
              "positive",
              "nonzero"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "concept",
          "op",
          "terms",
          "context",
          "period_rule",
          "multiplier",
          "denominator",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "tolerance": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "actual",
          "expected",
          "tolerance",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "finding",
              "no_exception",
              "not_applicable",
              "insufficient_evidence",
              "not_completed"
            ]
          },
          "reason": {
            "type": "string"
          },
          "procedures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "calculation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "rule_id",
          "status",
          "reason",
          "procedures",
          "evidence_ids",
          "calculation_ids",
          "finding_ids",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counter_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "calculation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observations": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_strength": {
            "enum": [
              "strong",
              "moderate",
              "limited"
            ]
          },
          "remaining_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "close_when": {
            "type": "string",
            "minLength": 1
          },
          "overlap_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "verified"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "evidence_ids",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "rule_ids",
          "evidence_ids",
          "counter_evidence_ids",
          "calculation_ids",
          "observations",
          "mechanism",
          "alternative_explanations",
          "assessment",
          "impact",
          "priority",
          "evidence_strength",
          "remaining_evidence",
          "close_when",
          "overlap_group",
          "review"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "knowledge",
    "report",
    "pages",
    "sections",
    "evidence",
    "facts",
    "calculations",
    "reconciliations",
    "coverage",
    "findings",
    "summary",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "enum": [
            "balance",
            "flow",
            "ratio",
            "days",
            "quantity",
            "unit_rate"
          ]
        }
      },
      "required": [
        "entity",
        "scope",
        "basis",
        "currency",
        "unit",
        "scale",
        "start",
        "end",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
